# ==============================================================================
# Silver Care — Środowisko deweloperskie i konfiguracyjne (.env.example)
# ==============================================================================
# Wymagania: @REQ: INFRA-EU-REGION, @REQ: SEC-SESSION, @REQ: SEC-PESEL-HASH
# Skopiuj ten plik do .env.local i uzupełnij odpowiednimi wartościami.
# NIGDY nie commituj plików zawierających prawdziwe klucze produkcyjne!
# ==============================================================================

# --- BAZA DANYCH (PostgreSQL / Supabase) ---
# Bezpośrednie i spulowane połączenie do bazy danych
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- SUPABASE API & AUTH ---
# URL instancji Supabase (lokalnie lub w chmurze EOG)
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Klucz publiczny anonimowy (dozwolony w warstwie przeglądarki)
SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Klucz uprzywilejowany service_role (ŚCIŚLE ZAKAZANY w przeglądarce, tylko backend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- BEZPIECZEŃSTWO & HASHOWANIE (@REQ: SEC-PESEL-HASH) ---
# Sól kryptograficzna do generowania jednokierunkowych skrótów HMAC-SHA256 numerów identyfikacyjnych
PESEL_HASH_SALT=silvercare_dev_pesel_hash_salt_min_32_chars

# --- INTEGRACJE WEARABLES (Polar AccessLink API) ---
# Dane aplikacji OAuth2 zarejestrowanej w portalu Polar
POLAR_CLIENT_ID=your-polar-client-id
POLAR_CLIENT_SECRET=your-polar-client-secret
POLAR_REDIRECT_URI=http://localhost:3000/api/polar/callback

# --- SZTUCZNA INTELIGENCJA & TRANSKRYPCJA GŁOSOWA (Groq / Whisper) ---
# Klucz API do transkrypcji audio Whisper oraz klasyfikacji tekstu
GROQ_API_KEY=your-groq-api-key
LLM_API_KEY=your-groq-or-eu-llm-key

# --- POWIADOMIENIA (E-mail & SMS) ---
# Dostawcy powiadomień transakcyjnych (Brevo / SendGrid / SMSAPI)
EMAIL_PROVIDER_KEY=your-email-provider-key
SMS_PROVIDER_KEY=your-sms-provider-key
SMSAPI_TOKEN=your-smsapi-token

# --- ZARZĄDZANIE PROJEKTEM (Trello API) ---
# Opcjonalne: synchronizacja zadań i kart projektowych z Trello
TRELLO_API=your-trello-api-key
TRELLO_TOKEN=your-trello-user-token
