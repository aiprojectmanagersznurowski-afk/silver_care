{
  "sc-write-gate": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "node .agents/hooks/ag-guard.mjs", "timeout": 10 }
        ]
      }
    ]
  },
  "sc-bash-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "node .agents/hooks/ag-guard.mjs", "timeout": 10 }
        ]
      }
    ]
  },
  "sc-session-context": {
    "PreInvocation": [
      { "type": "command", "command": "node .agents/hooks/ag-context.mjs", "timeout": 10 }
    ]
  }
}
