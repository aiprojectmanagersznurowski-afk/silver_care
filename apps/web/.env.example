# ==============================================================================
# Silver Care Web App — .env.example
# ==============================================================================
# Skopiuj do .env.local lub skonfiguruj zmienne w środowisku Next.js.
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PESEL_HASH_SALT=silvercare_dev_pesel_hash_salt_min_32_chars

POLAR_CLIENT_ID=your-polar-client-id
POLAR_CLIENT_SECRET=your-polar-client-secret
POLAR_REDIRECT_URI=http://localhost:3000/api/polar/callback

GROQ_API_KEY=your-groq-api-key
EMAIL_PROVIDER_KEY=your-email-provider-key
SMS_PROVIDER_KEY=your-sms-provider-key
