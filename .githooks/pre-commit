#!/usr/bin/env bash
# Bramka commitowa Silver Care — ostatnia linia obrony niezależna od IDE.
#
# Hooki IDE blokują zapis pliku. Ten hook blokuje commit. Potrzebne są oba:
# hook IDE nie zadziała, gdy plik powstanie poza agentem (ręcznie, z gita,
# przez inne narzędzie), a commit przechodzi zawsze przez to samo miejsce.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
FAIL=0

echo "▸ Bramka Silver Care (pre-commit)"

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# 1. Kontrakt spójny i bez dryfu — tylko gdy ruszono kontrakt lub artefakty
if echo "$staged" | grep -qE '^(contracts/|packages/contracts/)'; then
  node tools/sc-validate.mjs >/dev/null 2>&1   || { echo "  ✗ sc-validate"; FAIL=1; }
  node tools/sc-codegen.mjs --check >/dev/null 2>&1 || { echo "  ✗ dryf codegenu — uruchom: node tools/sc-codegen.mjs"; FAIL=1; }
fi

# 2. Wzorce zakazane w plikach kodu wchodzących do commita
#    Dokumentacja pominięta świadomie — cytuje zakazane wzorce jako przykłady.
SC_PROJECT_DIR="$ROOT" node tools/sc-precommit-scan.mjs $staged || FAIL=1

# 3. Nazewnictwo w całym repo
node tools/sc-naming.mjs >/dev/null 2>&1 || { echo "  ✗ sc-naming — uruchom: node tools/sc-naming.mjs"; FAIL=1; }

# 4. Konfiguracja Antigravity nie rozjechała się z Claude Code
if [ -d .agents ]; then
  node tools/sc-port-antigravity.mjs --check >/dev/null 2>&1 \
    || { echo "  ✗ .agents/ rozjechane — uruchom: node tools/sc-port-antigravity.mjs"; FAIL=1; }
fi

if [ $FAIL -ne 0 ]; then
  echo ""
  echo "  Commit zatrzymany. Pominięcie: git commit --no-verify (świadomie, nie z przyzwyczajenia)."
  exit 1
fi
echo "  ✓ bramka commitowa zielona"
